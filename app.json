{
  "expo": {
    "name": "Arwana Style Selector",
    "slug": "arwana-style-selector",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/arwana-icon.png",
    "scheme": "arwanastyleselector",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.begench.arwanastyleselector"
    },
    "android": {
      "package": "com.begench.arwanastyleselector",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3EC",
        "foregroundImage": "./assets/images/arwana-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/arwana-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3EC",
          "image": "./assets/images/arwana-foreground.png",
          "imageWidth": 160
        }
      ],
      "expo-image",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Arwana uses selected photos to build your offline interior catalog.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "30495913-b0f8-43fb-a1f8-990e67b3ee47"
      }
    }
  }
}
